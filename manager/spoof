#!/bin/bash
# mkkernel: gera um APK "spoofed" com pacote aleatorio e nome do app neutro.
# Rodar dentro de manager/.

word1=$(tr -dc 'a-z' </dev/urandom | head -c6)
word2=$(tr -dc 'a-z' </dev/urandom | head -c6)
word3=$(tr -dc 'a-z' </dev/urandom | head -c6)

echo "Pacote spoofed: $word1.$word2.$word3"
echo ""

# Move com/mkkernel/manager -> word1/word2/word3 nas arvores de codigo
for base in app/src/main/java app/src/main/aidl; do
    if [ -d "$base/com/mkkernel/manager" ]; then
        mkdir -p "$base/$word1/$word2"
        mv "$base/com/mkkernel/manager" "$base/$word1/$word2/$word3"
        rmdir "$base/com/mkkernel" 2>/dev/null
        rmdir "$base/com" 2>/dev/null
    fi
done

# Substitui o nome do pacote dentro dos arquivos
find . -type f \( -name '*.kt' -o -name '*.java' -o -name '*.kts' -o -name '*.xml' \
    -o -name '*.cc' -o -name '*.cpp' -o -name '*.h' -o -name '*.aidl' -o -name '*.pro' \) -exec sed -i \
    -e "s/com\.mkkernel\.manager/$word1.$word2.$word3/g" \
    -e "s/com\/mkkernel\/manager/$word1\/$word2\/$word3/g" \
    -e "s/com_mkkernel_manager/${word1}_${word2}_${word3}/g" {} +

# Nome do app neutro (nao revela "mkkernel" no launcher)
find app/src/main/res -name strings.xml -exec sed -i \
    -e "s/\(<string name=\"app_name\"[^>]*>\)mkkernel</\1${word3}</" {} +

# Marca a versao como -spoofed
if [ -f "./build.gradle.kts" ]; then
    sed -i 's/\(val managerVersionName by extra(getVersionName())\)/\1\nval managerVersionNameSpoofed = "${managerVersionName}-spoofed"/' ./build.gradle.kts
    sed -i 's/\(versionName = managerVersionName\)/versionName = managerVersionNameSpoofed/' ./build.gradle.kts
fi

if [ -f "./app/build.gradle.kts" ]; then
    sed -i '/val managerVersionName:/a val managerVersionNameSpoofed = "${managerVersionName}-spoofed"' ./app/build.gradle.kts
    sed -i 's/outputFileName = "KernelSU_Next_${managerVersionName}_${managerVersionCode}-\$name.apk"/outputFileName = "KernelSU_Next_${managerVersionNameSpoofed}_${managerVersionCode}-\$name.apk"/' ./app/build.gradle.kts
fi

echo "Done."
